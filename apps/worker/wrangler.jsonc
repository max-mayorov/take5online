{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "take5online",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "take5.mayorov.dev", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/relay/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  "ratelimits": [
    {
      // Room creation per IP; the namespace id only has to be unique within the account.
      "name": "CREATE_ROOM_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
  // PR previews (`wrangler preview`) don't inherit bindings. Each gets its own Durable Object storage.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }],
    },
    "ratelimits": [
      {
        // A separate namespace, so testing a preview doesn't use up production's budget.
        "name": "CREATE_ROOM_LIMIT",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 },
      },
    ],
    "observability": { "enabled": true },
  },
}
